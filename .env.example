# Copy to .env for local overrides. Production MUST set every value marked [prod].
# Comments must be on their own line: django-environ reads "x  # note" as the value "x  # note".
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# [prod] 32+ random chars
# DJANGO_SECRET_KEY=
# [prod] 32+ random chars, different from the secret key. Never rotate casually: NIN hashes depend on it.
# PII_HASH_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# [prod] e.g. https://criblink.ug
# DJANGO_CSRF_TRUSTED_ORIGINS=
# [prod] change to something unguessable, e.g. ops-7f3k2/
DJANGO_ADMIN_URL=admin/

# [prod] postgres://user:pass@host:5432/criblink
# DATABASE_URL=
# [prod] redis://host:6379/1
# CACHE_URL=
# [prod] redis://host:6379/0
# CELERY_BROKER_URL=
# prod defaults to 1 (one nginx/Render proxy); set 2 if behind Cloudflare + nginx
# NUM_PROXIES=

# [prod]
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
# [prod] false
AFRICASTALKING_SANDBOX=true

# [prod] Cloudflare R2: https://<account>.r2.cloudflarestorage.com
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# listing photos
# S3_PUBLIC_BUCKET=
# ID scans and ownership proof; no public access
# S3_PRIVATE_BUCKET=

# --- Managed viewing service (working assumptions from the 13 Nov 2026 plan) ---
# Pilot area, comma-separated
# SERVICE_AREAS=Ntinda,Kiwatule,Kigoowa,Naguru
# Fee per appointment in UGX (about US$12)
# VIEWING_FEE_UGX=44000

# Payments: "manual" (finance records mobile-money transactions) or "dev" (simulated, dev only)
PAYMENT_PROVIDER=manual
# [prod with manual payments] the business mobile-money number customers pay
# PAYMENT_MERCHANT_NUMBER=
# [prod with a webhook provider] 32+ random chars shared with the provider
# PAYMENT_WEBHOOK_SECRET=
# Shown to customers on their viewing page
# SUPPORT_PHONE=
